# Base de datos PostgreSQL (Supabase o cualquier Postgres). El pooler se usa
# en runtime; directUrl solo lo usa `prisma migrate`.
DATABASE_URL="postgresql://usuario:password@host:5432/policlinico"
DIRECT_URL="postgresql://usuario:password@host:5432/policlinico"

# NextAuth (Auth.js) — genera un secreto con: openssl rand -base64 32
AUTH_SECRET="reemplaza-esto-con-un-secreto-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"
